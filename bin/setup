#!/usr/bin/env bash
#
# Instalación en un paso del Panel Operativo de Incidencias (sin Docker).
#
#   bin/setup            instala sin borrar datos existentes
#   bin/setup --fresh    borra y recrea la demo (migrate:fresh --seed)
#
# Variables opcionales: DB_DATABASE, DB_USERNAME, DB_PASSWORD y DB_ROOT_PASSWORD
# (contraseña de root de MySQL, si la tiene; por defecto se prueba sin ella).
set -euo pipefail

FRESH=0
if [ "${1:-}" = "--fresh" ]; then FRESH=1; fi

DB_NAME="${DB_DATABASE:-incident_panel}"
DB_USER="${DB_USERNAME:-incident_user}"
DB_PASS="${DB_PASSWORD:-incident_password}"
ROOT_OPTS=(-uroot)
if [ -n "${DB_ROOT_PASSWORD:-}" ]; then ROOT_OPTS=(-uroot "-p${DB_ROOT_PASSWORD}"); fi

need() {
    command -v "$1" >/dev/null 2>&1 || { echo "ERROR: falta $1 ($2). Ver README §1." >&2; exit 1; }
}
need php ">= 8.4.1 con pdo_mysql, mbstring, xml, ctype y json"
need composer "2.x"
need npm "Node >= 20.19 (lo exige Vite 7)"
need mysql "8.0+ en marcha (p. ej. brew services start mysql@8.4)"

php -r 'version_compare(PHP_VERSION, "8.4.1", ">=") || exit(1);' \
    || { echo "ERROR: se necesita PHP >= 8.4.1 (Symfony 8 en composer.lock)." >&2; exit 1; }

echo "== 1/4 Base de datos =="
mysql "${ROOT_OPTS[@]}" -e "CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';
GRANT ALL ON \`${DB_NAME}\`.* TO '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;"

echo "== 2/4 Dependencias PHP y configuración =="
composer install --no-interaction

[ -f .env ] || cp .env.example .env
if grep -q '^DB_HOST=mysql$' .env 2>/dev/null; then
    echo "AVISO: tu .env apunta a DB_HOST=mysql (Docker, ya eliminado). Lo corrijo a 127.0.0.1." >&2
    sed -i '' 's/^DB_HOST=mysql$/DB_HOST=127.0.0.1/' .env 2>/dev/null \
        || sed -i 's/^DB_HOST=mysql$/DB_HOST=127.0.0.1/' .env
fi
# .env debe apuntar a la misma BD/usuario que se acaba de crear (también si se pasaron
# DB_DATABASE / DB_USERNAME / DB_PASSWORD por entorno). PHP ya es requisito: edición portable.
DB_NAME="$DB_NAME" DB_USER="$DB_USER" DB_PASS="$DB_PASS" php -r '
    $env = file_get_contents(".env");
    foreach (["DB_CONNECTION" => "mysql", "DB_DATABASE" => getenv("DB_NAME"),
              "DB_USERNAME" => getenv("DB_USER"), "DB_PASSWORD" => getenv("DB_PASS")] as $k => $v) {
        $line = $k."=".$v;
        $env = preg_match("/^".$k."=.*$/m", $env)
            ? preg_replace_callback("/^".$k."=.*$/m", fn () => $line, $env)
            : rtrim($env)."\n".$line."\n";
    }
    file_put_contents(".env", $env);'

if grep -q '^APP_KEY=$' .env; then
    php artisan key:generate
fi

echo "== 3/4 Migraciones y datos de ejemplo =="
TABLES="$(mysql "${ROOT_OPTS[@]}" -N -e "SHOW TABLES FROM \`${DB_NAME}\`" 2>/dev/null || true)"
if [ "$FRESH" = "1" ] || [ -z "$TABLES" ]; then
    php artisan migrate:fresh --seed --force
else
    echo "(hay tablas: migro sin borrar; usa --fresh para recrear la demo)"
    php artisan migrate --force
fi

echo "== 4/4 Frontend =="
npm ci            # respeta package-lock.json (npm install lo reescribiría)
npm run build

cat <<EOF

Listo. Para probarla:

    php artisan serve          # http://127.0.0.1:8000
    php artisan incidents:diagnose --fix --no-interaction   # demo del diagnóstico

El selector de operador sale con datos de ejemplo; gestiona trabajadores en /operators.
La documentación (instalación y arquitectura) se lee en la app, en Ayuda.
EOF
